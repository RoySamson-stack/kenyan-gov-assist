# Kenyan Gov Assist - Environment Variables

# ===========================================
# OLLAMA CONFIGURATION
# ===========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=kenyan-gov:latest
# Options: kenyan-gov:latest, kenyan-assitant, kenyan-deepseek, llama3.2:1b

# ===========================================
# APPLICATION SETTINGS
# ===========================================
APP_NAME=Serikali Yangu - Kenyan Language AI
DEFAULT_DOMAIN=civic
# Supported domains: civic, health, general

# ===========================================
# LANGUAGE SUPPORT
# ===========================================
SOURCE_LANGUAGE=english
# Supported: english, swahili, kikuyu, luo, kamba, kalenjin, luhya, somali, kisii, meru

# ===========================================
# SPEECH SERVICES
# ===========================================
WHISPER_MODEL=base
# Options: tiny, base, small, medium, large
TTS_ENABLED=true

# ===========================================
# TELECOM INTEGRATION (AFRICASTALKING)
# ===========================================
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your-api-key-here
# Get from: https://account.africastalking.com/

# ===========================================
# TELECOM INTEGRATION (TWILIO)
# ===========================================
TWILIO_ACCOUNT_SID=your-account-sid-here
TWILIO_AUTH_TOKEN=your-auth-token-here
TWILIO_VERIFICATION_SERVICE_SID=your-verification-service-sid
# Get from: https://www.twilio.com/console

# ===========================================
# PATHS (Relative to backend/)
# ===========================================
TRANSLATION_MEMORY_PATH=../data/translations
VECTOR_DB_PATH=../data/vector_db/chroma
RAW_DOCS_PATH=../data/raw
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ===========================================
# DOCUMENT PROCESSING
# ===========================================
MAX_FILE_SIZE_MB=50
# Allowed extensions: .pdf, .docx, .xlsx, .csv, .txt, .md, .epub, .html

# ===========================================
# FRONTEND (Vite/React)
# ===========================================
VITE_API_URL=http://localhost:8001
# For production, use: https://your-domain.com/api

# ===========================================
# SECURITY & CORS
# ===========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# For production: https://your-domain.com

# ===========================================
# REDIS CACHE (Optional)
# ===========================================
REDIS_URL=redis://localhost:6379
# Leave empty to use in-memory cache

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
